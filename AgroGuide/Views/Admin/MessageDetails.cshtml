@model BLL.DTOs.ContactMessageDTO

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Message Details";
}

<section class="py-5 bg-light">

    <div class="container">

        <div class="card border-0 shadow rounded-4">

            <div class="card-body p-5">

                <h2 class="fw-bold text-success mb-4">
                    Message Details
                </h2>

                <div class="mb-4">

                    <h5 class="fw-semibold">Name</h5>

                    <p>@Model.FullName</p>

                </div>

                <div class="mb-4">

                    <h5 class="fw-semibold">Email</h5>

                    <p>@Model.Email</p>

                </div>

                <div class="mb-4">

                    <h5 class="fw-semibold">Subject</h5>

                    <p>@Model.Subject</p>

                </div>

                <div class="mb-4">

                    <h5 class="fw-semibold">Message</h5>

                    <div class="border rounded-4 p-4 bg-light">
                        @Model.Message
                    </div>

                </div>

                @if (Model.IsReplied)
                {
                    <div class="mb-4">

                        <h5 class="fw-semibold text-success">
                            Reply Message
                        </h5>

                        <div class="border rounded-4 p-4 bg-success-subtle">
                            @Model.ReplyMessage
                        </div>

                    </div>
                }

                <div class="d-flex gap-2">

                    <a asp-controller="Admin"
                           asp-action="ReplyMessage"
                           asp-route-id="@Model.Id"
                           class="btn btn-success px-4">

                        <i class="bi bi-reply-fill me-2"></i>
                        Reply

                    </a>

                    <a asp-controller="Admin"
                           asp-action="Inbox"
                           class="btn btn-secondary px-4">

                        Back

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>