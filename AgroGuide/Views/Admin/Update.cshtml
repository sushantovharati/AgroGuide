@model BLL.DTOs.AdminDTO

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Update Admin Profile";
}

<section class="py-5 bg-light">
    <div class="container">

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="card border-0 shadow rounded-4">
                    <div class="card-body p-5">

                        <div class="text-center mb-5">
                            <i class="bi bi-pencil-square text-success"
                               style="font-size: 80px;"></i>

                            <h2 class="fw-bold text-success mt-3">
                                Update Profile
                            </h2>

                            <p class="text-muted">
                                Update your admin information
                            </p>
                        </div>

                        <form method="post">

                            <input asp-for="Id" type="hidden" />

                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <label class="form-label fw-semibold">First Name</label>
                                    <input asp-for="FirstName" class="form-control form-control-lg" />
                                </div>

                                <div class="col-md-6 mb-4">
                                    <label class="form-label fw-semibold">Last Name</label>
                                    <input asp-for="LastName" class="form-control form-control-lg" />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Email Address</label>
                                <input asp-for="Email" class="form-control form-control-lg" readonly />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Phone Number</label>
                                <input asp-for="Phone" class="form-control form-control-lg" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Date of Birth</label>
                                <input asp-for="DoB" type="date" class="form-control form-control-lg" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Address</label>
                                <textarea asp-for="Address"
                                          rows="4"
                                          class="form-control form-control-lg"></textarea>
                            </div>

                            <div class="d-flex gap-3 mt-4">

                                <button type="submit"
                                        class="btn btn-success px-5 py-3 rounded-3 fw-semibold">
                                    <i class="bi bi-check-circle me-2"></i>
                                    Update Profile
                                </button>

                                <a asp-controller="Admin"
                                       asp-action="Profile"
                                       class="btn btn-secondary px-5 py-3 rounded-3 fw-semibold">
                                    Cancel
                                </a>

                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>
</section>