@model BLL.DTOs.FertilizerDTO

@{
    ViewData["Title"] = "Fertilizer Details";

    var role = Context.Session.GetString("Role");

    if (role == "Farmer")
    {
        Layout = "~/Views/Shared/_FarmerLayout.cshtml";
    }
    else if (role == "Admin")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<section class="py-5 bg-light">

    <div class="container">

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

            <div class="row g-0">

                <!-- Image -->
                <div class="col-lg-5">

                    <img src="@Model.ImageUrl"
                         class="img-fluid w-100 h-100 object-fit-cover"
                         alt="@Model.FertilizerName"
                         style="min-height: 500px;" />

                </div>

                <!-- Details -->
                <div class="col-lg-7">

                    <div class="card-body p-5">

                        <div class="mb-4">

                            <span class="badge bg-success px-4 py-3 fs-6 rounded-pill mb-3">
                                @Model.Type
                            </span>

                            <h1 class="fw-bold text-success">
                                @Model.FertilizerName
                            </h1>

                        </div>

                        <hr />

                        <!-- Information -->
                        <div class="row g-4 mt-2">

                            <div class="col-md-6">

                                <div class="border rounded-4 p-4 bg-light h-100">

                                    <h5 class="fw-bold text-success mb-3">
                                        Quantity Per Acre
                                    </h5>

                                    <p class="mb-0">
                                        @Model.QuantityPerAcre Kg
                                    </p>

                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="border rounded-4 p-4 bg-light h-100">

                                    <h5 class="fw-bold text-success mb-3">
                                        Price
                                    </h5>

                                    <p class="mb-0">
                                        ৳ @Model.Price
                                    </p>

                                </div>

                            </div>

                        </div>

                        <!-- Usage -->
                        <div class="mt-5">

                            <h4 class="fw-bold text-success mb-3">
                                Usage Instruction
                            </h4>

                            <p class="text-muted lh-lg mb-0">
                                @Model.UsageInstruction
                            </p>

                        </div>

                        <!-- Buttons -->
                        <div class="mt-5 d-flex gap-3">

                            <a asp-controller="Fertilizer"
                                   asp-action="Index"
                                   class="btn btn-outline-success px-4 py-3 rounded-3 fw-semibold">

                                <i class="bi bi-arrow-left me-2"></i>
                                Back to Fertilizers

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>