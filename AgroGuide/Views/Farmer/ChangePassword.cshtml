@{
    Layout = "~/Views/Shared/_FarmerLayout.cshtml";
    ViewData["Title"] = "Change Password";
}

<section class="py-5 bg-light">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="card border-0 shadow rounded-4">

                    <div class="card-body p-5">

                        <div class="text-center mb-5">

                            <i class="bi bi-key-fill text-success"
                               style="font-size: 90px;"></i>

                            <h2 class="fw-bold text-success mt-3">
                                Change Password
                            </h2>

                            <p class="text-muted">
                                Update your account password
                            </p>

                        </div>

                        @if (TempData["Msg"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["Msg"]
                            </div>
                        }

                        <form method="post">

                            <!-- New Password -->
                            <div class="mb-4">

                                <label class="form-label fw-semibold">
                                    New Password
                                </label>

                                <input type="password"
                                       name="password"
                                       class="form-control form-control-lg"
                                       placeholder="Enter new password" />

                            </div>

                            <!-- Buttons -->
                            <div class="d-flex gap-3 mt-4">

                                <button type="submit"
                                        class="btn btn-success px-5 py-3 rounded-3 fw-semibold">

                                    <i class="bi bi-check-circle me-2"></i>
                                    Change Password

                                </button>

                                <a asp-controller="Farmer"
                                       asp-action="Profile"
                                       class="btn btn-secondary px-5 py-3 rounded-3 fw-semibold">

                                    Cancel

                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>