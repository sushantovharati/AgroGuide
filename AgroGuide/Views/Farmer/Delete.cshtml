@model BLL.DTOs.FarmerDTO

@{
    Layout = "~/Views/Shared/_FarmerLayout.cshtml";
    ViewData["Title"] = "Delete Account";
}

<section class="py-5 bg-light">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="card border-0 shadow rounded-4">

                    <div class="card-body p-5 text-center">

                        <div class="mb-4">

                            <i class="bi bi-exclamation-triangle-fill text-danger"
                               style="font-size: 90px;"></i>

                        </div>

                        <h2 class="fw-bold text-danger mb-3">
                            Delete Account
                        </h2>

                        <p class="text-muted fs-5">
                            Are you sure you want to permanently delete your farmer account?
                        </p>

                        <div class="bg-light border rounded-4 p-4 mt-4 text-start">

                            <p>
                                <strong>Name:</strong><br />
                                @Model.FirstName @Model.LastName
                            </p>

                            <p>
                                <strong>Email:</strong><br />
                                @Model.Email
                            </p>

                            <p class="mb-0">
                                <strong>Phone:</strong><br />
                                @Model.Phone
                            </p>

                        </div>

                        <form method="post" class="mt-5">

                            <input type="hidden" name="confirm" value="yes" />

                            <div class="d-flex justify-content-center gap-3">

                                <button type="submit"
                                        class="btn btn-danger px-5 py-3 rounded-3 fw-semibold">

                                    <i class="bi bi-trash me-2"></i>
                                    Delete Account

                                </button>

                                <a asp-controller="Farmer"
                                       asp-action="Profile"
                                       class="btn btn-secondary px-5 py-3 rounded-3 fw-semibold">

                                    Cancel

                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>