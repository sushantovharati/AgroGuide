@model BLL.DTOs.DiseaseDTO

@{
    ViewData["Title"] = "Disease Details";

    var role = Context.Session.GetString("Role");

    if (role == "Farmer")
    {
        Layout = "~/Views/Shared/_FarmerLayout.cshtml";
    }
    else if (role == "Admin")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<section class="py-5 bg-light">

    <div class="container">

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

            <div class="row g-0">

                <!-- Image -->
                <div class="col-lg-5">

                    <img src="@Model.ImageUrl"
                         class="img-fluid w-100 h-100 object-fit-cover"
                         alt="@Model.DiseaseName"
                         style="min-height: 500px;" />

                </div>

                <!-- Details -->
                <div class="col-lg-7">

                    <div class="card-body p-5">

                        <div class="mb-4">

                            <h1 class="fw-bold text-danger">
                                @Model.DiseaseName
                            </h1>

                        </div>

                        <hr />

                        <!-- Symptoms -->
                        <div class="mt-4">

                            <h4 class="fw-bold text-danger mb-3">
                                Symptoms
                            </h4>

                            <p class="text-muted lh-lg">
                                @Model.Symptoms
                            </p>

                        </div>

                        <!-- Causes -->
                        <div class="mt-4">

                            <h4 class="fw-bold text-danger mb-3">
                                Causes
                            </h4>

                            <p class="text-muted lh-lg">
                                @Model.Causes
                            </p>

                        </div>

                        <!-- Solution -->
                        <div class="mt-4">

                            <h4 class="fw-bold text-danger mb-3">
                                Solution
                            </h4>

                            <p class="text-muted lh-lg">
                                @Model.Solution
                            </p>

                        </div>

                        <!-- Prevention -->
                        <div class="mt-4">

                            <h4 class="fw-bold text-danger mb-3">
                                Prevention
                            </h4>

                            <p class="text-muted lh-lg">
                                @Model.Prevention
                            </p>

                        </div>

                        <!-- Buttons -->
                        <div class="mt-5 d-flex gap-3">

                            <a asp-controller="Disease"
                                   asp-action="Index"
                                   class="btn btn-outline-danger px-4 py-3 rounded-3 fw-semibold">

                                <i class="bi bi-arrow-left me-2"></i>
                                Back to Diseases

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>